---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contacts from '../../components/Contacts.astro';
import { services, site } from '../../data/site';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { service } = Astro.props;
---

<BaseLayout title={`${service.title} | Адвокат ${site.name}`} description={`${service.description} Личная практика Харви Спектра. Консультации в Нью-Йорке и онлайн.`}>
  <div id="top"></div>
  <Header />
  <main id="main">
    <section class="service-hero"><div class="container"><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href={withBase('/')}>Главная</a><span aria-hidden="true">/</span><a href={withBase('/#practice')}>Практика</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav><p class="eyebrow">НАПРАВЛЕНИЕ {service.number} · {service.label}</p><h1>{service.title}<span>.</span></h1><p class="service-intro">{service.intro}</p><a class="button button-accent" href="#contacts">Обсудить задачу <span aria-hidden="true">↗</span></a></div></section>
    <section class="section-space"><div class="container service-content"><div><p class="eyebrow">С ЧЕМ МОЖНО ОБРАТИТЬСЯ</p><h2>Задачи в рамках<br /><span>этого направления.</span></h2><ul class="task-list">{service.tasks.map((task) => <li><span aria-hidden="true">↗</span>{task}</li>)}</ul></div><aside class="preparation-card"><span class="eyebrow">ПОДГОТОВКА К ВСТРЕЧЕ</span><h2>С чего начать</h2><p>{service.preparation}</p><a class="text-link" href={`mailto:${site.email}`}>Задать вопрос ↗</a></aside></div></section>
    <section class="related-section section-space"><div class="container"><p class="eyebrow">ДРУГИЕ НАПРАВЛЕНИЯ</p><h2>Также могу помочь</h2><div class="related-links">{services.filter((item) => item.slug !== service.slug).map((item) => <a href={withBase(`/practice/${item.slug}/`)}>{item.title}<span aria-hidden="true">↗</span></a>)}</div></div></section>
    <Contacts />
  </main>
  <Footer />
</BaseLayout>
